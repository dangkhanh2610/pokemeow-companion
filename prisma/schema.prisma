generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trainer {
  userId          String               @id
  username        String
  displayName     String               @default("")
  avatarUrl       String               @default("")
  coins           Int                  @default(2500)
  xp              Int                  @default(0)
  level           Int                  @default(1)
  totalCatches    Int                  @default(0)
  totalEncounters Int                  @default(0)
  shinyCatches    Int                  @default(0)
  dailyStreak     Int                  @default(0)
  lastDailyAt     DateTime?
  lastWildAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  inventory       InventoryItem[]
  creatures       CaughtCreature[]
  encounters      ActiveEncounter[]
  transactions    EconomyTransaction[]
}

model InventoryItem {
  id        String  @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int     @default(0)
  trainer   Trainer @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, itemId])
}

model CaughtCreature {
  id          String   @id @default(cuid())
  userId      String
  speciesId   Int
  speciesName String
  rarity      String
  isShiny     Boolean  @default(false)
  ivTotal     Int
  ivPercent   Float
  ivsJson     Json
  level       Int      @default(1)
  ballUsed    String
  released    Boolean  @default(false)
  caughtAt    DateTime @default(now())
  trainer     Trainer  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, released, caughtAt(sort: Desc)])
  @@index([userId, speciesId, isShiny])
  @@index([isShiny, rarity, caughtAt(sort: Desc)])
}

model ActiveEncounter {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  speciesId Int
  isShiny   Boolean  @default(false)
  ivsJson   Json
  status    String   @default("OPEN")
  expiresAt DateTime
  createdAt DateTime @default(now())
  trainer   Trainer  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
}

model EconomyTransaction {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  userId         String
  type           String
  coinsDelta     Int
  metadata       Json
  createdAt      DateTime @default(now())
  trainer        Trainer  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model GuildConfig {
  guildId   String   @id
  prefix    String   @default(";")
  updatedAt DateTime @updatedAt
}
